# -----------------------------------------------------------------------------
# WormWise - Environment Variables Template
# Copy this file to .env.local and fill in the values for local development.
# DO NOT commit real secrets or production credentials to version control.
# -----------------------------------------------------------------------------

# Next.js Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth & PostgreSQL Database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HiveMQ Cloud MQTT Broker
MQTT_BROKER_URL=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=wormwise-dev-service

# InfluxDB Time-Series Telemetry
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=wormwise-telemetry
